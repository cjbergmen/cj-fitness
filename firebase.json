{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/*.png",
        "headers": [{"key": "Content-Type", "value": "image/png"}]
      },
      {
        "source": "manifest.json",
        "headers": [{"key": "Content-Type", "value": "application/manifest+json"}]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
